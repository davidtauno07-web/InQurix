# InQurix server configuration. Copy to .env and fill in. Never commit .env.
# Local PostgreSQL (your own machine). Example for a local install:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/inqurix?schema=public"
PORT=4100
# Public URL of the web/server origin (used in emails and OAuth redirects)
APP_URL="http://localhost:4100"
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=""
# Ed25519 private key (PKCS8 PEM, \n-escaped) used to sign plan entitlements the desktop app verifies offline.
# Generate: npm run keys -w @inqurix/server
ENTITLEMENT_PRIVATE_KEY=""
ENTITLEMENT_PUBLIC_KEY=""
# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: SMTP for verification/recovery emails. If empty, emails are written to the server log (development only).
SMTP_URL=""
MAIL_FROM="InQurix <no-reply@localhost>"
# Paddle Billing (sandbox: https://sandbox-vendors.paddle.com). Leave empty to disable checkout.
PADDLE_ENV="sandbox"
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_PRO_MONTHLY=""
PADDLE_PRICE_BUSINESS_MONTHLY=""
